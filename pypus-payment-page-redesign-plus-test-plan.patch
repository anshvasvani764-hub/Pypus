diff --git a/components/subscribe/subscribe.module.css b/components/subscribe/subscribe.module.css
new file mode 100644
index 0000000..aeb6e2a
--- /dev/null
+++ b/components/subscribe/subscribe.module.css
@@ -0,0 +1,416 @@
+.root {
+  --cream: #0b0b08;
+  --cream-2: #15140f;
+  --ink: #f5f4ef;
+  --ink-soft: #c4c3b9;
+  --muted: #96968c;
+  --emerald: #10b981;
+  --emerald-dark: #059669;
+  --emerald-tint: #0f2a21;
+  --amber: #f59e0b;
+  --amber-tint: #2a1f0b;
+  --line: rgba(255, 255, 255, 0.09);
+  --line-strong: rgba(255, 255, 255, 0.16);
+
+  min-height: 100svh;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  background: #08080a;
+  color: var(--ink);
+  font-family: var(--font-inter), -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+  position: relative;
+  overflow: hidden;
+  padding: 28px 20px 48px;
+}
+
+.mono {
+  font-family: var(--font-jetbrains-mono), monospace;
+}
+
+/* ── ambient glow, quieter than the landing hero ── */
+.glow {
+  position: absolute;
+  inset: 0;
+  z-index: 0;
+  pointer-events: none;
+}
+
+.glow::before,
+.glow::after {
+  content: "";
+  position: absolute;
+  border-radius: 50%;
+  filter: blur(10px);
+}
+
+.glow::before {
+  width: 480px;
+  height: 480px;
+  top: -180px;
+  right: -140px;
+  background: radial-gradient(circle, rgba(16, 185, 129, 0.22), transparent 70%);
+}
+
+.glow::after {
+  width: 420px;
+  height: 420px;
+  bottom: -200px;
+  left: -140px;
+  background: radial-gradient(circle, rgba(20, 184, 166, 0.14), transparent 70%);
+}
+
+.header {
+  position: relative;
+  z-index: 1;
+  width: 100%;
+  max-width: 1040px;
+  display: flex;
+  align-items: center;
+  padding: 8px 4px 0;
+}
+
+.logo {
+  display: flex;
+  align-items: center;
+  gap: 9px;
+  font-weight: 700;
+  font-size: 16px;
+  color: var(--ink);
+  text-decoration: none;
+  letter-spacing: -0.01em;
+}
+
+.logoMark {
+  width: 26px;
+  height: 26px;
+  border-radius: 7px;
+  object-fit: cover;
+}
+
+.body {
+  position: relative;
+  z-index: 1;
+  flex: 1;
+  width: 100%;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  padding-top: 28px;
+}
+
+.workspace {
+  font-family: var(--font-jetbrains-mono), monospace;
+  font-size: 11.5px;
+  font-weight: 600;
+  letter-spacing: 0.07em;
+  text-transform: uppercase;
+  color: var(--muted);
+  margin-bottom: 10px;
+}
+
+/* status pill — the one "signature" element; its color/label is derived
+   directly from why the workspace is gated, so it carries real info. */
+.pill {
+  display: inline-flex;
+  align-items: center;
+  gap: 7px;
+  font-family: var(--font-jetbrains-mono), monospace;
+  font-size: 11.5px;
+  font-weight: 600;
+  letter-spacing: 0.05em;
+  padding: 6px 13px;
+  border-radius: 100px;
+  margin-bottom: 20px;
+  color: var(--emerald-dark);
+  background: var(--emerald-tint);
+  border: 1px solid rgba(16, 185, 129, 0.22);
+}
+
+.pillDot {
+  width: 6px;
+  height: 6px;
+  border-radius: 50%;
+  background: currentColor;
+}
+
+.pillAmber {
+  color: #fbbf24;
+  background: var(--amber-tint);
+  border-color: rgba(245, 158, 11, 0.28);
+}
+
+.heading {
+  font-size: clamp(24px, 4vw, 30px);
+  font-weight: 700;
+  letter-spacing: -0.015em;
+  text-align: center;
+  max-width: 480px;
+  line-height: 1.25;
+}
+
+.sub {
+  margin-top: 12px;
+  font-size: 15px;
+  line-height: 1.6;
+  color: var(--ink-soft);
+  text-align: center;
+  max-width: 400px;
+}
+
+.testBadge {
+  margin-top: 14px;
+  font-family: var(--font-jetbrains-mono), monospace;
+  font-size: 11px;
+  font-weight: 600;
+  letter-spacing: 0.05em;
+  color: #fbbf24;
+  background: var(--amber-tint);
+  border: 1px dashed rgba(245, 158, 11, 0.4);
+  border-radius: 8px;
+  padding: 5px 10px;
+}
+
+.card {
+  margin-top: 30px;
+  width: 100%;
+  max-width: 380px;
+  background: var(--cream-2);
+  border: 1px solid var(--line);
+  border-radius: 20px;
+  padding: 28px;
+  transition: border-color 0.25s, box-shadow 0.25s;
+}
+
+.card:hover {
+  border-color: var(--line-strong);
+  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
+}
+
+.planRow {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+}
+
+.planName {
+  font-size: 14.5px;
+  font-weight: 600;
+  color: var(--ink);
+}
+
+.price {
+  font-family: var(--font-jetbrains-mono), monospace;
+  font-weight: 700;
+  font-size: 32px;
+  letter-spacing: -0.02em;
+  color: var(--ink);
+}
+
+.priceSuffix {
+  font-size: 13.5px;
+  font-weight: 500;
+  color: var(--muted);
+  margin-left: 3px;
+}
+
+.divider {
+  height: 1px;
+  background: var(--line);
+  margin: 20px 0;
+}
+
+.features {
+  list-style: none;
+  padding: 0;
+  margin: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 11px;
+}
+
+.feature {
+  display: flex;
+  align-items: flex-start;
+  gap: 9px;
+  font-size: 14px;
+  color: var(--ink-soft);
+  line-height: 1.4;
+}
+
+.featureIcon {
+  flex-shrink: 0;
+  margin-top: 1px;
+  color: var(--emerald);
+}
+
+.ctaWrap {
+  margin-top: 24px;
+}
+
+.cta {
+  width: 100%;
+  min-height: 48px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  background: var(--emerald);
+  color: #fff;
+  font-family: inherit;
+  font-size: 15px;
+  font-weight: 600;
+  border: none;
+  border-radius: 11px;
+  cursor: pointer;
+  transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
+}
+
+.cta:hover:not(:disabled) {
+  background: var(--emerald-dark);
+  transform: translateY(-1px);
+  box-shadow: 0 10px 28px rgba(5, 150, 105, 0.3);
+}
+
+.cta:focus-visible {
+  outline: 2px solid var(--emerald);
+  outline-offset: 2px;
+}
+
+.cta:disabled {
+  cursor: not-allowed;
+  opacity: 0.65;
+  transform: none;
+  box-shadow: none;
+}
+
+.spin {
+  animation: subscribeSpin 0.8s linear infinite;
+}
+
+@keyframes subscribeSpin {
+  to {
+    transform: rotate(360deg);
+  }
+}
+
+.errorText {
+  margin-top: 10px;
+  font-size: 13px;
+  color: #f87171;
+  text-align: center;
+}
+
+.trust {
+  margin-top: 22px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 7px;
+  font-size: 12.5px;
+  color: var(--muted);
+}
+
+.trustIcon {
+  color: var(--muted);
+  flex-shrink: 0;
+}
+
+.footNote {
+  margin-top: 10px;
+  font-size: 12px;
+  color: var(--muted);
+  text-align: center;
+  max-width: 340px;
+}
+
+/* ── return / status page ── */
+.resultCard {
+  margin-top: 30px;
+  width: 100%;
+  max-width: 400px;
+  background: var(--cream-2);
+  border: 1px solid var(--line);
+  border-radius: 20px;
+  padding: 36px 28px;
+  text-align: center;
+}
+
+.resultIconWrap {
+  width: 52px;
+  height: 52px;
+  border-radius: 50%;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  margin: 0 auto 18px;
+  background: var(--emerald-tint);
+  color: var(--emerald);
+}
+
+.resultIconWrap.fail {
+  background: rgba(248, 113, 113, 0.12);
+  color: #f87171;
+}
+
+.resultHeading {
+  font-size: 21px;
+  font-weight: 700;
+  letter-spacing: -0.01em;
+}
+
+.resultSub {
+  margin-top: 10px;
+  font-size: 14.5px;
+  color: var(--ink-soft);
+  line-height: 1.55;
+}
+
+.resultLink {
+  margin-top: 24px;
+  display: inline-flex;
+  min-height: 46px;
+  align-items: center;
+  justify-content: center;
+  gap: 7px;
+  padding: 0 26px;
+  border-radius: 11px;
+  font-size: 14.5px;
+  font-weight: 600;
+  text-decoration: none;
+  transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
+}
+
+.resultLinkPrimary {
+  background: var(--emerald);
+  color: #fff;
+}
+
+.resultLinkPrimary:hover {
+  background: var(--emerald-dark);
+  transform: translateY(-1px);
+  box-shadow: 0 10px 28px rgba(5, 150, 105, 0.3);
+}
+
+.resultLinkGhost {
+  background: transparent;
+  color: var(--ink);
+  border: 1.5px solid var(--line-strong);
+}
+
+.resultLinkGhost:hover {
+  border-color: var(--ink);
+  background: rgba(245, 244, 239, 0.06);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .spin {
+    animation: none;
+  }
+  .card,
+  .cta,
+  .resultLink {
+    transition: none;
+  }
+}
diff --git a/lib/subscriptions/plans.ts b/lib/subscriptions/plans.ts
