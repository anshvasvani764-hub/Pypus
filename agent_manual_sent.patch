+/** Called when the owner has sent the receipt themselves manually (own
+ * phone/CRM, since automatic WhatsApp sending is off — see
+ * AUTO_WHATSAPP_ENABLED). This is what actually flips a receipt from
+ * "Queued" to "Sent" in the Agent log right now. */
+export async function markReceiptSentManually(
+  receiptId: string
+): Promise<{ success: boolean; error?: string }> {
+  const supabase = createServiceClient();
+
+  const { error } = await supabase
+    .from("receipts")
+    .update({
+      whatsapp_sent_at: new Date().toISOString(),
+      whatsapp_status: "sent_manual",
+    })
+    .eq("id", receiptId);
+
+  if (error) {
+    console.error("markReceiptSentManually update error:", error);
+    return { success: false, error: error.message };
+  }
+
+  revalidatePath(`/[app]/agent`, "page");
+  return { success: true };
+}
