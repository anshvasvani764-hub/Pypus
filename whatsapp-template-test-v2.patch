+"use client";
+
+import { useMemo, useState } from "react";
+import { FlaskConical, Loader2, Send, ChevronDown, MessageCircle } from "lucide-react";
+import { PageHeader } from "@/components/layout/PageHeader";
+import { sendTestTemplate } from "@/app/actions/template-test";
+import type { TemplateSummary } from "@/lib/whatsapp/templates";
+
+interface Member {
+  id: string;
+  name: string;
+  phone: string | null;
+}
+
+interface TemplateTestViewProps {
+  workspaceName: string;
+  members: Member[];
+  templates: TemplateSummary[];
+  templatesError?: string;
+}
+
+type Status = "idle" | "sending" | "sent" | "error";
+
+const fieldClass =
+  "w-full rounded-xl border border-gray-200 bg-white px-3.5 py-2.5 text-sm text-gray-900 outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 disabled:cursor-not-allowed disabled:bg-gray-50 disabled:text-gray-400";
+const labelClass = "mb-1.5 block text-xs font-semibold text-gray-600";
+
+export function TemplateTestView({
+  workspaceName,
+  members,
+  templates,
+  templatesError,
+}: TemplateTestViewProps) {
+  const [memberId, setMemberId] = useState("");
+  const [templateKey, setTemplateKey] = useState("");
+  const [bodyValues, setBodyValues] = useState<string[]>([]);
+  const [headerImageLink, setHeaderImageLink] = useState("");
+  const [status, setStatus] = useState<Status>("idle");
+  const [message, setMessage] = useState("");
+
+  const selectedMember = members.find((m) => m.id === memberId);
+  const selectedTemplate = templates.find((t) => t.key === templateKey);
+
+  const previewText = useMemo(() => {
+    const text = selectedTemplate?.bodyText;
+    if (!text) return "";
+    let result = text;
+    bodyValues.forEach((val, i) => {
+      result = result.replace(new RegExp(`\\{\\{${i + 1}\\}\\}`, "g"), val || `{{${i + 1}}}`);
+    });
+    return result;
+  }, [selectedTemplate, bodyValues]);
+
+  function handleTemplateChange(key: string) {
+    setTemplateKey(key);
+    const tpl = templates.find((t) => t.key === key);
+    setBodyValues(new Array(tpl?.bodyVariableCount ?? 0).fill(""));
+    setHeaderImageLink("");
+    setStatus("idle");
+    setMessage("");
+  }
+
+  function updateBodyValue(index: number, value: string) {
+    setBodyValues((prev) => {
+      const next = [...prev];
+      next[index] = value;
+      return next;
+    });
+  }
+
+  async function handleSend() {
+    if (!selectedMember?.phone) {
+      setStatus("error");
+      setMessage("Select a member with a phone number");
+      return;
+    }
+    if (!selectedTemplate) {
+      setStatus("error");
+      setMessage("Select a template");
+      return;
+    }
+    if (selectedTemplate.needsHeaderImage && !headerImageLink.trim()) {
+      setStatus("error");
+      setMessage("This template needs a public header image URL");
+      return;
+    }
+
+    setStatus("sending");
+    setMessage("");
+
+    const result = await sendTestTemplate({
+      phone: selectedMember.phone,
+      templateName: selectedTemplate.name,
+      languageCode: selectedTemplate.language,
+      bodyParams: bodyValues,
+      headerImageLink: headerImageLink.trim() || undefined,
+    });
+
+    if (!result.success) {
+      setStatus("error");
+      setMessage(result.error || "Something went wrong");
+      return;
+    }
+
+    setStatus("sent");
+    setMessage(`Sent to ${selectedMember.name} (${result.sentTo})`);
+  }
+
+  return (
+    <div className="space-y-6 px-6 py-6 md:px-8">
+      <PageHeader
+        title="Template test"
+        subtitle={`Send an approved WhatsApp template to a ${workspaceName} member and see exactly how it'll look on their end.`}
+        actions={
+          <div className="hidden sm:flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1.5 text-xs font-medium text-emerald-700">
+            <FlaskConical className="h-3.5 w-3.5" />
+            Test only
+          </div>
+        }
+      />
+
+      {templatesError && (
+        <div className="rounded-2xl border border-red-100 bg-red-50 px-4 py-3 text-sm text-red-700">
+          Couldn&apos;t load templates: {templatesError}
+        </div>
+      )}
+
+      {!templatesError && templates.length === 0 && (
+        <div className="rounded-2xl border border-dashed border-gray-200 bg-white px-6 py-10 text-center text-sm text-gray-500">
+          No APPROVED templates found in this WABA yet.
+        </div>
+      )}
+
+      <div className="grid gap-6 lg:grid-cols-2">
+        {/* Form card */}
+        <div className="space-y-4 rounded-2xl border border-gray-200 bg-white p-5">
+          <div>
+            <label className={labelClass}>Member</label>
+            <div className="relative">
+              <select
+                value={memberId}
+                onChange={(e) => setMemberId(e.target.value)}
+                className={`${fieldClass} appearance-none pr-9`}
+              >
+                <option value="">Select member</option>
+                {members.map((m) => (
+                  <option key={m.id} value={m.id} disabled={!m.phone}>
+                    {m.name} {m.phone ? `· ${m.phone}` : "(no phone)"}
+                  </option>
+                ))}
+              </select>
+              <ChevronDown className="pointer-events-none absolute right-3 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-gray-400" />
+            </div>
+            {members.length === 0 && (
+              <p className="mt-1.5 text-xs text-gray-400">No members in this workspace yet.</p>
+            )}
+          </div>
+
+          <div>
+            <label className={labelClass}>Template</label>
+            <div className="relative">
+              <select
+                value={templateKey}
+                onChange={(e) => handleTemplateChange(e.target.value)}
+                disabled={templates.length === 0}
+                className={`${fieldClass} appearance-none pr-9`}
+              >
+                <option value="">Select template</option>
+                {templates.map((t) => (
+                  <option key={t.key} value={t.key}>
+                    {t.name} [{t.language}] · {t.category}
+                  </option>
+                ))}
+              </select>
+              <ChevronDown className="pointer-events-none absolute right-3 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-gray-400" />
+            </div>
+          </div>
+
+          {selectedTemplate?.needsHeaderImage && (
+            <div>
+              <label className={labelClass}>Header image URL (public https link)</label>
+              <input
+                type="url"
+                placeholder="https://..."
+                value={headerImageLink}
+                onChange={(e) => setHeaderImageLink(e.target.value)}
+                className={fieldClass}
+              />
+            </div>
+          )}
+
+          {bodyValues.map((val, i) => (
+            <div key={i}>
+              <label className={labelClass}>{`Variable {{${i + 1}}}`}</label>
+              <input
+                type="text"
+                value={val}
+                onChange={(e) => updateBodyValue(i, e.target.value)}
+                className={fieldClass}
+              />
+            </div>
+          ))}
+
+          <button
+            type="button"
+            onClick={handleSend}
+            disabled={status === "sending" || !memberId || !templateKey}
+            className="flex w-full items-center justify-center gap-1.5 rounded-xl bg-emerald-600 px-3.5 py-2.5 text-sm font-medium text-white hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-50 transition-colors"
+          >
+            {status === "sending" ? (
+              <Loader2 className="h-3.5 w-3.5 animate-spin" />
+            ) : (
+              <Send className="h-3.5 w-3.5" />
+            )}
+            {status === "sending" ? "Sending..." : "Send test message"}
+          </button>
+
+          {message && (
+            <p className={`text-xs ${status === "error" ? "text-red-600" : "text-emerald-700"}`}>
+              {message}
+            </p>
+          )}
+        </div>
+
+        {/* Preview card */}
+        <div className="rounded-2xl border border-gray-200 bg-white p-5">
+          <div className="mb-3 flex items-center gap-1.5 text-xs font-semibold text-gray-500">
+            <MessageCircle className="h-3.5 w-3.5" />
+            HOW IT&apos;LL LOOK
+          </div>
+          {selectedTemplate ? (
+            <div className="rounded-2xl bg-[#DCF8C6] p-3.5 text-sm text-gray-800 shadow-sm">
+              {selectedTemplate.needsHeaderImage && (
+                <div className="mb-2 flex h-28 items-center justify-center rounded-lg bg-white/60 text-xs text-gray-500">
+                  {headerImageLink ? "Image header" : "Image header (add a URL)"}
+                </div>
+              )}
+              <p className="whitespace-pre-wrap">{previewText}</p>
+            </div>
+          ) : (
+            <div className="flex h-32 items-center justify-center rounded-2xl border border-dashed border-gray-200 text-xs text-gray-400">
+              Pick a template to preview it here
+            </div>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+}
