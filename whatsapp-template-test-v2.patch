--- /dev/null
+++ b/lib/whatsapp/templates.ts
@@ -0,0 +1,93 @@
+/**
+ * Fetches this WABA's APPROVED message templates from Meta, with the
+ * body text and {{1}}, {{2}}... variable count already parsed out so
+ * callers don't have to re-derive it. Server-only (uses WHATSAPP_ACCESS_TOKEN).
+ */
+
+const WHATSAPP_API_VERSION = "v21.0";
+
+export interface TemplateComponentSummary {
+  type: "HEADER" | "BODY" | "FOOTER" | "BUTTONS";
+  format?: "TEXT" | "IMAGE" | "VIDEO" | "DOCUMENT" | "LOCATION";
+  text?: string;
+  variableCount: number;
+}
+
+export interface TemplateSummary {
+  /** Unique key for a <select> — same template name can exist per language. */
+  key: string;
+  name: string;
+  language: string;
+  category: string;
+  components: TemplateComponentSummary[];
+  bodyText: string;
+  bodyVariableCount: number;
+  needsHeaderImage: boolean;
+}
+
+function countVariables(text?: string): number {
+  if (!text) return 0;
+  const matches = text.match(/\{\{\d+\}\}/g);
+  return matches ? new Set(matches).size : 0;
+}
+
+export async function getApprovedTemplates(): Promise<{
+  templates: TemplateSummary[];
+  error?: string;
+}> {
+  const token = process.env.WHATSAPP_ACCESS_TOKEN;
+  const wabaId = process.env.WHATSAPP_BUSINESS_ACCOUNT_ID;
+
+  if (!token) return { templates: [], error: "WHATSAPP_ACCESS_TOKEN env var is not set" };
+  if (!wabaId) return { templates: [], error: "WHATSAPP_BUSINESS_ACCOUNT_ID env var is not set" };
+
+  try {
+    const url = `https://graph.facebook.com/${WHATSAPP_API_VERSION}/${wabaId}/message_templates?fields=name,status,language,category,components&limit=200`;
+    const res = await fetch(url, {
+      headers: { Authorization: `Bearer ${token}` },
+      cache: "no-store",
+    });
+    const data = await res.json();
+
+    if (!res.ok) {
+      const message = data?.error?.message || `Meta API error (${res.status})`;
+      return { templates: [], error: message };
+    }
+
+    const templates: TemplateSummary[] = (data?.data ?? [])
+      .filter((t: { status: string }) => t.status === "APPROVED")
+      .map(
+        (t: {
+          name: string;
+          language: string;
+          category: string;
+          components: Array<{ type: string; format?: string; text?: string }>;
+        }) => {
+          const components: TemplateComponentSummary[] = (t.components ?? []).map((c) => ({
+            type: c.type as TemplateComponentSummary["type"],
+            format: c.format as TemplateComponentSummary["format"],
+            text: c.text,
+            variableCount: countVariables(c.text),
+          }));
+
+          const body = components.find((c) => c.type === "BODY");
+          const header = components.find((c) => c.type === "HEADER");
+
+          return {
+            key: `${t.name}__${t.language}`,
+            name: t.name,
+            language: t.language,
+            category: t.category,
+            components,
+            bodyText: body?.text ?? "",
+            bodyVariableCount: body?.variableCount ?? 0,
+            needsHeaderImage: header?.format === "IMAGE",
+          };
+        }
+      );
+
+    return { templates };
+  } catch (err) {
+    return { templates: [], error: err instanceof Error ? err.message : "Unknown error" };
+  }
+}
