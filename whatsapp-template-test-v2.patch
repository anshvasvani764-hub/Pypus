+import { createServiceClient } from "@/lib/supabase/service";
+import { getApprovedTemplates } from "@/lib/whatsapp/templates";
+import { TemplateTestView } from "@/components/automations/TemplateTestView";
+
+export default async function TemplateTestPage({
+  params,
+}: {
+  params: Promise<{ app: string }>;
+}) {
+  const { app: workspaceSlug } = await params;
+
+  const supabase = createServiceClient();
+  const { data: wsData } = await supabase
+    .from("workspaces")
+    .select("id, name")
+    .eq("slug", workspaceSlug)
+    .single();
+  const workspaceId = wsData?.id ?? "";
+  const workspaceName = wsData?.name ?? "Your Gym";
+
+  const { data: members } = await supabase
+    .from("members")
+    .select("id, name, phone")
+    .eq("workspace_id", workspaceId)
+    .order("name");
+
+  const { templates, error: templatesError } = await getApprovedTemplates();
+
+  return (
+    <TemplateTestView
+      workspaceName={workspaceName}
+      members={members ?? []}
+      templates={templates}
+      templatesError={templatesError}
+    />
+  );
+}
