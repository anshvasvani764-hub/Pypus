+    title: "Capability model",
+    keywords: ["scope", "out of scope", "can you", "can pypus", "feature", "module"],
+    content:
+      "Pypus is intended as a whole-app assistant, not a hard-coded assistant for only a few modules. The available UI context, knowledge sections and typed tools define what can be explained or acted on. If no appropriate capability exists for a requested live action, say that access/action is currently unavailable rather than using a fixed module-scope refusal.",
+  },
+];
+
+function normalize(value: string): string {
+  return value.toLowerCase().replace(/[^a-z0-9\u0900-\u097f]+/g, " ").trim();
+}
+
+function tokenSet(value: string): Set<string> {
+  return new Set(normalize(value).split(/\s+/).filter((token) => token.length > 1));
+}
+
+function scoreSection(section: KnowledgeSection, queryTokens: Set<string>, ui?: PypusUIContext | null): number {
+  let score = 0;
+  const searchable = tokenSet(
+    `${section.title} ${section.module ?? ""} ${section.screen ?? ""} ${section.keywords.join(" ")}`
+  );
+
+  for (const token of queryTokens) {
+    if (searchable.has(token)) score += 3;
+  }
+
+  if (ui?.module && section.module === ui.module) score += 5;
+  if (ui?.screen && section.screen === ui.screen) score += 7;
+
+  // Strong hints for common Hindi/Hinglish UI questions.
+  const q = normalize(Array.from(queryTokens).join(" "));
+  if (section.id === "how-to" && /(kaise|kese|how|steps|process)/.test(q)) score += 5;
+  if (section.id === "reference-resolution" && /(ye|yeh|iska|uska|usko|iss|wala|this|that)/.test(q)) score += 5;
+  if (section.id === "ui-awareness" && /(screen|page|visible|selected|button)/.test(q)) score += 4;
+
+  return score;
+}
+
+/**
+ * Returns only the most relevant sections. The caller should never send the
+ * complete KNOWLEDGE array to the model.
+ */
+export function getRelevantPypusKnowledge(
+  query: string,
+  uiContext?: PypusUIContext | null,
+  maxSections = 3
+): string {
+  const queryTokens = tokenSet(query);
+  if (queryTokens.size === 0) return "";
+
+  const ranked = KNOWLEDGE
+    .map((section) => ({ section, score: scoreSection(section, queryTokens, uiContext) }))
+    .filter(({ score }) => score > 0)
+    .sort((a, b) => b.score - a.score)
+    .slice(0, maxSections);
+
+  if (ranked.length === 0) return "";
+
+  return ranked
+    .map(({ section }) => `### ${section.title}\n${section.content}`)
+    .join("\n\n");
+}
+
+export const PYPUS_KNOWLEDGE_SECTION_IDS = KNOWLEDGE.map((section) => section.id);
