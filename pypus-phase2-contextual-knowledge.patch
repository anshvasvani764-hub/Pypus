+import type { PypusUIContext } from "@/lib/pypus/ui-context";
+
+/**
+ * Small, deterministic retrieval layer for Pypus' product knowledge.
+ *
+ * IMPORTANT:
+ * - This is NOT business data. Never use it for member/payment amounts.
+ * - We intentionally keep knowledge in small sections so the whole manual
+ *   does not have to be sent to the model on every message.
+ * - Later this can be replaced by embeddings/vector search without changing
+ *   the route contract.
+ */
+type KnowledgeSection = {
+  id: string;
+  title: string;
+  module?: string;
+  screen?: string;
+  keywords: string[];
+  content: string;
+};
+
