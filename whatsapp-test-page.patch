+import { NextResponse } from "next/server"
+import { createServiceClient } from "@/lib/supabase/service"
+
+export interface DirectoryMember {
+  id: string
+  name: string
+  phone: string | null
+}
+
+export interface DirectoryWorkspace {
+  id: string
+  name: string
+  members: DirectoryMember[]
+}
+
+/**
+ * Local-only test endpoint: lists all workspaces + their members (name,
+ * phone) so the test page can offer a workspace -> member picker instead
+ * of typing a number by hand. Uses the service-role client since this is
+ * a local dev utility with no user session gating. Remove alongside the
+ * rest of /api/whatsapp-test before prod.
+ */
+export async function GET() {
+  try {
+    const supabase = createServiceClient()
+
+    const { data: workspaces, error: wsError } = await supabase
+      .from("workspaces")
+      .select("id, name")
+      .order("name")
+
+    if (wsError) {
+      return NextResponse.json({ error: wsError.message }, { status: 500 })
+    }
+
+    const { data: members, error: memError } = await supabase
+      .from("members")
+      .select("id, name, phone, workspace_id")
+      .order("name")
+
+    if (memError) {
+      return NextResponse.json({ error: memError.message }, { status: 500 })
+    }
+
+    const result: DirectoryWorkspace[] = (workspaces ?? []).map((ws) => ({
+      id: ws.id,
+      name: ws.name,
+      members: (members ?? [])
+        .filter((m) => m.workspace_id === ws.id)
+        .map((m) => ({ id: m.id, name: m.name, phone: m.phone })),
+    }))
+
+    return NextResponse.json({ workspaces: result })
+  } catch (err) {
+    return NextResponse.json(
+      { error: err instanceof Error ? err.message : "Unknown error" },
+      { status: 500 }
+    )
+  }
+}
