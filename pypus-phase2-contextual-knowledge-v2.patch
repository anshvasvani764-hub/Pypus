diff --git a/lib/pypus/knowledge.ts b/lib/pypus/knowledge.ts
new file mode 100644
--- /dev/null
+++ b/lib/pypus/knowledge.ts
@@ -0,0 +1,62 @@
+import type { PypusUIContext } from "@/lib/pypus/ui-context";
+
+type KnowledgeSection = {
+  id: string;
+  module?: string;
+  screen?: string;
+  keywords: string[];
+  content: string;
+};
+
+const KNOWLEDGE: KnowledgeSection[] = [
+  { id: "navigation", keywords: ["home", "dashboard", "navigate", "navigation", "kaha", "ja", "open"], content: "Pypus is organized around the business areas exposed by the current workspace. Home/Dashboard is the starting point. For how-to questions, explain the shortest route from the user's current screen to the destination." },
+  { id: "members", module: "members", screen: "members", keywords: ["member", "members", "customer", "client", "user"], content: "Members is used to find and manage people in the business. The member list opens member profiles. Live names, phone numbers, plans, fees and statuses must come from business-data tools." },
+  { id: "member-profile", module: "members", screen: "member_details", keywords: ["profile", "details", "iska", "iss user", "ye wala"], content: "A member profile is the focused view for one member. UI context can resolve references such as 'iska', 'iss user' and 'ye wala'. Verify mutable member and payment facts with tools." },
+  { id: "fees", module: "fees", screen: "fees", keywords: ["fee", "fees", "payment", "payments", "due", "pending", "paid", "collection"], content: "Fees contains fee/payment workflows. Use business-data tools for actual amounts, dates, due status and payment history." },
+  { id: "plans", module: "fees", screen: "fees_plans", keywords: ["plan", "plans", "fee plan", "membership plan", "package"], content: "Fees → Plans is where membership plans are managed. A plan generally contains the fields exposed by the current form, such as name, duration and fee." },
+  { id: "create-plan", module: "fees", screen: "fees_plans", keywords: ["create plan", "make plan", "new plan", "plan banana", "plan banao", "add plan", "kaise banate"], content: "To create a fee plan: go to Fees → Plans → Create Plan, fill the fields shown by the form, then save. Do not claim fields or controls that the current UI does not expose." },
+  { id: "payments", module: "fees", keywords: ["payment", "paid", "payment history", "fee aayi", "paisa aaya", "receipt", "kab aayi"], content: "Payment questions about who paid, how much, when, or pending status require live business-data tools. Product knowledge only explains where/how the workflow works." },
+  { id: "reminders", module: "fees", keywords: ["reminder", "fee reminder", "remind", "whatsapp reminder", "message"], content: "Fee-reminder workflows notify members when the relevant capability exists. Sending a message is a real action and requires the appropriate typed tool; never claim success without a successful tool result." },
+  { id: "attendance", module: "attendance", screen: "attendance", keywords: ["attendance", "present", "absent", "check in", "check-in"], content: "Attendance records and reviews member check-ins. Live counts and records come from attendance tools; how-to answers should follow the current UI." },
+  { id: "expenses", module: "expenses", screen: "expenses", keywords: ["expense", "expenses", "kharcha", "cost", "category"], content: "Expenses manages business expense records and categories. Actual amounts, dates and records come from business-data tools." },
+  { id: "team", module: "team", screen: "team", keywords: ["team", "staff", "employee", "trainer", "role", "invite"], content: "Team manages staff/team members and roles where those controls are exposed. Use live tools for actual team data and permissions." },
+  { id: "automations", module: "automations", keywords: ["automation", "automate", "workflow", "trigger", "automatic"], content: "Automations are repeatable workflows using configured triggers/actions exposed by the workspace. Do not invent unavailable triggers or actions." },
+  { id: "settings", module: "settings", screen: "settings", keywords: ["settings", "setting", "configuration", "preferences"], content: "Settings contains configuration controls exposed by the current workspace. Explain the route based on current UI context." },
+  { id: "ui-awareness", keywords: ["screen", "page", "visible", "selected", "button", "current screen", "ye wala", "this", "that"], content: "UI context answers where the user is, what screen/module is open, what entity is selected, what is visible, what actions are available and what the user just did. It is semantic context, not a screenshot and not database truth." },
+  { id: "how-to", keywords: ["how", "how do", "kaise", "kese", "steps", "step", "process", "route"], content: "For how-to questions, identify the current screen, retrieve the smallest relevant app-knowledge sections, then give only the necessary route and steps. Do not paste unrelated documentation." },
+  { id: "references", keywords: ["ye", "yeh", "iska", "uska", "usko", "iss", "this", "that", "wala", "selected"], content: "References such as 'ye wala', 'this plan', 'iska' or 'iss user' should be resolved from current UI selection/visible context, with conversation context as a secondary clue. If ambiguous, ask." },
+  { id: "data-vs-knowledge", keywords: ["data", "database", "live", "actual", "amount", "number", "date", "status"], content: "Product knowledge explains how Pypus works; it is not live business data. Never use it to invent names, amounts, dates, phone numbers, statuses or counts. Use typed business tools." },
+  { id: "capability", keywords: ["scope", "out of scope", "can you", "can pypus", "feature", "module"], content: "Pypus is a whole-app assistant, not a fixed-module assistant. UI context, knowledge and typed tools define current capabilities. If a live action has no tool, say that access/action is currently unavailable instead of using a hard-coded scope refusal." },
+];
+
+const normalize = (value: string) =>
+  value.toLowerCase().replace(/[^a-z0-9\u0900-\u097f]+/g, " ").trim();
+
+export function getRelevantPypusKnowledge(
+  query: string,
+  uiContext?: PypusUIContext | null,
+  maxSections = 3
+): string {
+  const normalizedQuery = normalize(query);
+  const tokens = new Set(normalizedQuery.split(/\s+/).filter((x) => x.length > 1));
+  if (!tokens.size) return "";
+
+  const ranked = KNOWLEDGE.map((section) => {
+    const searchable = normalize(
+      `${section.id} ${section.module ?? ""} ${section.screen ?? ""} ${section.keywords.join(" ")}`
+    );
+    let score = 0;
+    for (const token of tokens) if (searchable.includes(token)) score += 3;
+    if (uiContext?.module && section.module === uiContext.module) score += 5;
+    if (uiContext?.screen && section.screen === uiContext.screen) score += 7;
+    if (section.id === "how-to" && /kaise|kese|how|steps|process/.test(normalizedQuery)) score += 5;
+    if (section.id === "references" && /ye|yeh|iska|uska|usko|iss|wala|this|that/.test(normalizedQuery)) score += 5;
+    return { section, score };
+  })
+    .filter((x) => x.score > 0)
+    .sort((a, b) => b.score - a.score)
+    .slice(0, maxSections);
+
+  return ranked.map(({ section }) => `### ${section.id}\n${section.content}`).join("\n\n");
+}
