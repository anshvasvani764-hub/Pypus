diff --git a/lib/receipts/template-vars.ts b/lib/receipts/template-vars.ts
new file mode 100644
index 0000000..8d7ad70
--- /dev/null
+++ b/lib/receipts/template-vars.ts
@@ -0,0 +1,46 @@
+import { formatReceiptDate } from "@/lib/utils/date";
+
+/**
+ * The 5 variables that fill the approved "payment_receipt" WhatsApp
+ * template's {{1}}-{{5}} placeholders, in this exact order:
+ *   {{1}} member name, {{2}} amount, {{3}} workspace/gym name,
+ *   {{4}} payment method, {{5}} valid till date
+ *
+ * Edited from the Receipt Agent's script modal and persisted on
+ * receipts.whatsapp_template_vars (jsonb). When a receipt has saved vars,
+ * those exact values go out on WhatsApp instead of the auto-computed
+ * defaults from lib/agent/queries.ts.
+ *
+ * `validTillDate` is kept as a plain ISO date (YYYY-MM-DD) or null here —
+ * it's only formatted for display/send at the edges (buildReceipt* below),
+ * so it round-trips cleanly through a <input type="date">.
+ */
+export interface ReceiptTemplateVars {
+  name: string;
+  amount: number;
+  workspaceName: string;
+  paymentMethod: string;
+  validTillDate: string | null;
+}
+
+/** Body params for sendWhatsAppTemplate's `bodyParams`, in the template's
+ * {{1}}-{{5}} order. */
+export function buildReceiptTemplateBodyParams(vars: ReceiptTemplateVars): string[] {
+  return [
+    vars.name,
+    vars.amount.toLocaleString("en-IN"),
+    vars.workspaceName,
+    vars.paymentMethod,
+    vars.validTillDate ? formatReceiptDate(vars.validTillDate) : "—",
+  ];
+}
+
+/** Best-effort preview of what the approved template renders as on
+ * WhatsApp. The exact copy lives in Meta's template library — this just
+ * mirrors it closely enough for the owner to sanity-check the variables
+ * before sending, and updates live as the fields below are edited. */
+export function buildReceiptPreviewText(vars: ReceiptTemplateVars): string {
+  const amountStr = vars.amount.toLocaleString("en-IN");
+  const validTill = vars.validTillDate ? formatReceiptDate(vars.validTillDate) : "—";
+  return `Hi ${vars.name}, thanks for your payment of ₹${amountStr} to ${vars.workspaceName} via ${vars.paymentMethod}. Your membership is valid till ${validTill}. Please save this message for your records.`;
+}
diff --git a/supabase/migrations/20260905020000_receipt_whatsapp_template_vars.sql b/supabase/migrations/20260905020000_receipt_whatsapp_template_vars.sql
new file mode 100644
index 0000000..2e7e25f
--- /dev/null
+++ b/supabase/migrations/20260905020000_receipt_whatsapp_template_vars.sql
@@ -0,0 +1,14 @@
+-- Adds structured, editable WhatsApp template variables to receipts,
+-- replacing the old freeform whatsapp_message_override text field for new
+-- edits going forward (that column stays in place for any historical rows,
+-- it's just no longer written to).
+--
+-- Shape: { name, amount, workspaceName, paymentMethod, validTillDate }
+-- — the exact {{1}}-{{5}} values for the approved "payment_receipt"
+-- template (see app/actions/agent.ts / lib/receipts/template-vars.ts).
+-- When null, the Receipt Agent falls back to auto-computed defaults from
+-- lib/agent/queries.ts. When set (the owner edited the fields in the
+-- Receipt Agent's script modal), these exact values are sent to WhatsApp.
+
+alter table public.receipts
+  add column if not exists whatsapp_template_vars jsonb;
