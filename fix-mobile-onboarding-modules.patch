+    async function fetchTemplates() {
+      const { data, error } = await supabase
+        .from('templates')
+        .select('*')
+        .order('created_at', { ascending: true })
+
+      if (error || !data) return
+
+      // `templates` rows don't carry a `modules` column — modules live in
+      // the `template_modules` join table. Without this fetch,
+      // template.modules stays undefined -> [] and workspace creation
+      // fails for EVERY industry (see performWorkspaceCreation's
+      // `!selectedTemplate.modules?.length` guard).
+      const ids = data.map((t: any) => t.id)
+      const { data: tmData } = await supabase
+        .from('template_modules')
+        .select('template_id, module_id, is_required, modules(id, slug, name)')
+        .in('template_id', ids)
+
+      const modulesByTemplate: Record<string, any[]> = {}
+      ;(tmData || []).forEach((tm: any) => {
+        if (!tm.modules) return
+        if (!modulesByTemplate[tm.template_id]) modulesByTemplate[tm.template_id] = []
+        modulesByTemplate[tm.template_id].push(tm.modules)
       })
+
+      const withModules = data.map((t: any) => ({
+        ...t,
+        modules: modulesByTemplate[t.id] || [],
+      }))
+
+      setTemplates(withModules)
+    }
+
+    fetchTemplates()
